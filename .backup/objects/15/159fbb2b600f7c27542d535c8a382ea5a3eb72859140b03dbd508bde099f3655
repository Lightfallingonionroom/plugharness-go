name: Golden then APK (temporary)
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  goldens:
    runs-on: ubuntu-24.04
    timeout-minutes: 40
    env:
      DSH_TEST_FONT_DIR: /usr/share/fonts/opentype/noto
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - uses: subosito/flutter-action@1a449444c387b1966244ae4d4f8c696479add0b2
        with:
          flutter-version: 3.47.7
          channel: stable
          cache: true
      - name: Gate - analyze
        working-directory: app
        run: |
          flutter pub get --enforce-lockfile
          flutter analyze --no-pub
      - name: Restore test fonts
        id: fonts
        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9
        with:
          path: ~/test-fonts
          key: test-fonts-1:20230817+repack1-3-v2.051
      - name: Install test fonts
        if: steps.fonts.outputs.cache-hit != 'true'
        run: |
          sudo apt-get update -q
          apt-get download fonts-noto-cjk="1:20230817+repack1-3" fonts-noto-cjk-extra="1:20230817+repack1-3"
          for deb in fonts-noto-cjk*.deb; do dpkg-deb -x "$deb" unpacked; done
          mkdir -p ~/test-fonts
          cp unpacked/usr/share/fonts/opentype/noto/NotoSansCJK-{Regular,Bold,Light}.ttc ~/test-fonts/
          curl -fsSL --retry 3 -o ~/test-fonts/NotoColorEmoji.ttf https://raw.githubusercontent.com/googlefonts/noto-emoji/v2.051/fonts/NotoColorEmoji.ttf
      - name: Save test fonts
        if: steps.fonts.outputs.cache-hit != 'true'
        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9
        with:
          path: ~/test-fonts
          key: test-fonts-1:20230817+repack1-3-v2.051
      - name: Activate test fonts
        run: |
          sudo install -Dm644 -t /usr/share/fonts/opentype/noto ~/test-fonts/NotoSansCJK-*.ttc
          sudo install -Dm644 ~/test-fonts/NotoColorEmoji.ttf /usr/share/fonts/noto/NotoColorEmoji.ttf
      - name: Regenerate the empty-state suites
        working-directory: app
        run: |
          python3 tool/l10n_merge.py
          flutter test --no-pub --update-goldens --concurrency=2 --reporter expanded \
            test/chat/chat_golden_test.dart \
            test/chat/chat_shell_test.dart \
            test/chat/empty_actions_test.dart \
            test/chat/chat_screen_test.dart
      - name: What changed
        working-directory: app
        run: git status --short | sed -n '1,40p'
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: goldens-empty-state
          path: app/test/**/goldens/*.png

  apk:
    needs: goldens
    runs-on: ubuntu-24.04
    timeout-minutes: 60
    env:
      FLUTTER_VERSION: 3.47.7
      NODE_VERSION: 24.22.1
      GRADLE_VERSION: 9.3.1
      DSH_MAVEN_MIRRORS: 0
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7
        with:
          node-version: ${{ env.NODE_VERSION }}
      - uses: subosito/flutter-action@1a449444c387b1966244ae4d4f8c696479add0b2
        with:
          flutter-version: ${{ env.FLUTTER_VERSION }}
          channel: stable
          cache: true
      - uses: actions/setup-java@b843ebf9b913146b38da2eaa7aeddf76074ae1ad
        with:
          distribution: temurin
          java-version: '17'
      - name: Cache runtime inputs
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9
        with:
          path: runtime/.cache
          key: runtime-inputs-r15-${{ runner.os }}
      - name: Build the arm64 Linux runtime
        run: runtime/build-runtime.sh arm64-v8a
      - name: Reclaim runtime build workspace
        run: |
          rm -rf runtime/.work runtime/.cache
      - name: Flutter plugins and Android SDK paths
        working-directory: app
        run: |
          flutter pub get --enforce-lockfile
          printf 'sdk.dir=%s\nflutter.sdk=%s\n' "$ANDROID_HOME" "$FLUTTER_ROOT" > android/local.properties
      - uses: gradle/actions/setup-gradle@8da46b539cd8fe6ab27ca75128919a18d757604c # v4
        with:
          gradle-version: ${{ env.GRADLE_VERSION }}
      - name: Build release APK
        run: tooling/build-apk.sh --release -f arm64
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: plugharness-go-arm64-apk
          path: app/build/app/outputs/flutter-apk/*.apk