import 'dart:convert';
import 'dart:io';

import 'package:archive/archive.dart';
import 'package:flutter/painting.dart';
import 'package:flutter/services.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:path_provider/path_provider.dart';

import 'pet_pack.dart';

const customPetPrefix = 'custom-';

/// Custom packs live in app-private files/pets/<id>, a location the native
/// overlay already supports. Bundled assets remain untouched.
class CustomPetStore {
  const CustomPetStore();

  Future<Directory> root() async => Directory('${(await getApplicationDocumentsDirectory()).path}/pets');

  Future<List<PetPack>> list() async {
    final dir = await root();
    if (!await dir.exists()) return const [];
    final result = <PetPack>[];
    await for (final entry in dir.list(followLinks: false)) {
      if (entry is! Directory || !entry.path.split(Platform.pathSeparator).last.startsWith(customPetPrefix)) continue;
      try {
        result.add(await PetPack.load(entry.path.split(Platform.pathSeparator).last));
      } catch (_) {
        // A broken custom pack must not hide the built-ins or other packs.
      }
    }
    return result;
  }

  Future<PetPack> importImage(List<int> bytes, String name) async {
    if (bytes.isEmpty || bytes.length > 8 * 1024 * 1024) throw const FormatException('image size');
    final dimensions = await decodeImageFromList(Uint8List.fromList(bytes));
    final w = dimensions.width, h = dimensions.height;
    dimensions.dispose();
    if (w <= 0 || h <= 0 || w > 4096 || h > 4096) throw const FormatException('image dimensions');
    final id = '$customPetPrefix${DateTime.now().microsecondsSinceEpoch}';
    final dir = Directory('${(await root()).path}/$id');
    await dir.create(recursive: true);
    try {
      await File('${dir.path}/pet.png').writeAsBytes(bytes, flush: true);
      final pack = singleImagePack(id: id, name: name.trim().isEmpty ? 'Custom pet' : name.trim(), width: w, height: h);
      await File('${dir.path}/pack.json').writeAsString(jsonEncode(_singleImageJson(pack)), flush: true);
      return PetPack.parse(jsonDecode(await File('${dir.path}/pack.json').readAsString()));
    } catch (_) {
      await dir.delete(recursive: true);
      rethrow;
    }
  }

  Future<PetPack> importArchive(List<int> bytes) async {
    if (bytes.isEmpty || bytes.length > 32 * 1024 * 1024) throw const FormatException('archive size');
    final archive = ZipDecoder().decodeBytes(bytes, verify: true);
    final manifests = archive.files.where((file) => file.isFile && file.name.split('/').last == 'pack.json').toList();
    if (manifests.length != 1) throw const FormatException('one pack.json required');
    final manifest = manifests.single;
    final prefix = manifest.name.substring(0, manifest.name.length - 'pack.json'.length);
    final parsed = jsonDecode(utf8.decode(manifest.content as List<int>));
    if (parsed is! Map<String, Object?>) throw const FormatException('pack.json');
    final pack = PetPack.parse(parsed);
    if (pack.animations.values.any((anim) => anim.sheet.contains('/') || anim.sheet.contains('..'))) {
      throw const FormatException('unsafe sheet path');
    }
    final files = <String, List<int>>{};
    var total = 0;
    for (final file in archive.files) {
      if (!file.isFile || !file.name.startsWith(prefix)) continue;
      final relative = file.name.substring(prefix.length);
      if (relative.isEmpty || relative.contains('/') || relative == '.' || relative == '..' || relative.contains('\\')) {
        throw const FormatException('unsafe archive path');
      }
      final content = file.content as List<int>;
      total += content.length;
      if (total > 96 * 1024 * 1024) throw const FormatException('uncompressed size');
      files[relative] = content;
    }
    for (final animation in pack.animations.values) {
      if (!files.containsKey(animation.sheet)) throw FormatException('missing ${animation.sheet}');
    }
    final id = '$customPetPrefix${DateTime.now().microsecondsSinceEpoch}';
    final dir = Directory('${(await root()).path}/$id');
    await dir.create(recursive: true);
    try {
      for (final entry in files.entries) {
        await File('${dir.path}/${entry.key}').writeAsBytes(entry.value, flush: true);
      }
      final stored = Map<String, Object?>.from(parsed)..['id'] = id;
      await File('${dir.path}/pack.json').writeAsString(jsonEncode(stored), flush: true);
      return PetPack.parse(stored);
    } catch (_) {
      await dir.delete(recursive: true);
      rethrow;
    }
  }

  Future<void> delete(String id) async {
    if (!RegExp(r'^custom-[a-zA-Z0-9-]+$').hasMatch(id)) throw ArgumentError.value(id);
    final dir = Directory('${(await root()).path}/$id');
    if (await dir.exists()) await dir.delete(recursive: true);
  }
}

PetPack singleImagePack({required String id, required String name, required int width, required int height}) =>
    PetPack.parse(_singleImageJsonValues(id, name, width, height));

Map<String, Object?> _singleImageJson(PetPack pack) => _singleImageJsonValues(
  pack.id,
  pack.name,
  pack.canvas.width.round(),
  pack.canvas.height.round(),
);

Map<String, Object?> _singleImageJsonValues(String id, String name, int w, int h) => {
  'schema': 1,
  'id': id,
  'name': name,
  'author': 'User',
  'pixelArt': false,
  'canvas': {'w': w, 'h': h},
  'anchor': {'x': w / 2, 'baseline': h},
  'contentBox': {'x': 0, 'y': 0, 'w': w, 'h': h},
  'animations': {
    'idle': {
      'sheet': 'pet.png',
      'frameW': w,
      'frameH': h,
      'cols': 1,
      'box': {'x': 0, 'y': 0, 'w': w, 'h': h},
      'frames': [
        {'i': 0, 'ms': 1000},
      ],
    },
  },
  'states': {
    for (final state in const [
      'idle', 'working', 'thinking', 'attention', 'waiting', 'done', 'error',
      'carrying', 'sleeping', 'waking', 'roam',
    ])
      state: ['idle'],
  },
};

class FilePetBundle extends AssetBundle {
  FilePetBundle(this.bundle);

  final AssetBundle bundle;

  @override
  Future<ByteData> load(String key) async {
    if (key.startsWith('${PetPack.folder(customPetPrefix)}')) {
      final base = (await getApplicationDocumentsDirectory()).path;
      final relative = key.substring('assets/pets/'.length);
      final parts = relative.split('/');
      if (parts.length == 2 && RegExp(r'^custom-[a-zA-Z0-9-]+$').hasMatch(parts[0]) &&
          RegExp(r'^[a-zA-Z0-9._-]+$').hasMatch(parts[1])) {
        return (await File('$base/pets/${parts[0]}/${parts[1]}').readAsBytes()).buffer.asByteData();
      }
    }
    return bundle.load(key);
  }
}

final customPetStoreProvider = Provider<CustomPetStore>((ref) => const CustomPetStore());
final customPetPacksProvider = FutureProvider<List<PetPack>>((ref) => ref.watch(customPetStoreProvider).list());
